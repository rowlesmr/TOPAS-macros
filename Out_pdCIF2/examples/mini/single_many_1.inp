#include "../../pdcif2.inc"

macro ciffile { "single_many_1_2.cif" }
system_before_save_OUT { del ciffile }


Out_CIF2_initialise(ciffile)

CIF2_set_audit_dataset_id("0b6e4472-1302-47b3-a52e-041e644fc48b")




yobs_eqn row_A = 1; min 10 max 70 del 5
	bkg 0 1 2
    Out_CIF2_wavelength_cuka1(ciffile, "radiation_src")

	CIF2_set_cif_id(1)
    CIF2_set_instr_id("Stoel")
	CIF2_set_scan_method("step")

	str
		phase_name "Selenium"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
		CIF2_set_crystal_system("hexagonal")
		scale 1e-4
		Hexagonal(3.992, 3.119)
		space_group "R-3m"
        CIF2_set_space_group_id("R-3m")
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Tin"
		CIF2_set_phase_id("This_is_a_unique_string")
		CIF2_set_formula_units_Z(2)
		CIF2_set_crystal_system("tetragonal")
		scale 1e-4
		Tetragonal(3.448, 3.251)
		space_group "I4/mmm"
        CIF2_set_space_group_id("I4/mmm")
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1

	Out_pdCIF2_per_xdd(ciffile, "meas")

yobs_eqn row_B = 2; min 10 max 70 del 5
	bkg 1 2 4
    Out_CIF2_wavelength_cuka1(ciffile, "radiation_src")

	CIF2_set_cif_id(2)
    CIF2_set_instr_id("Rigaker")
	CIF2_set_scan_method("cont")

	str
		phase_name "Selenium"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
		CIF2_set_crystal_system("hexagonal")
		scale 1e-4
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
        CIF2_set_space_group_id("R-3m")
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Second"
		CIF2_set_formula_units_Z(2)
		CIF2_set_crystal_system("tetragonal")
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
        CIF2_set_space_group_id("I4/mmm")
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.

	str
		phase_name "Tin"
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Sn")
		CIF2_set_crystal_system("tetragonal")
		scale 1e-4
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
        CIF2_set_space_group_id("I4/mmm")
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1

	Out_pdCIF2_per_xdd(ciffile, "proc",)

