#include "../cif.inc"

macro ciffile { "multi_one.cif" }
system_before_save_OUT { del ciffile }

prm CIF_SCAN_METHOD = "cont";
prm CIF_DATETIME = "2022-01-11T14:32:57+0200" ;

yobs_eqn row_1_01.xy = 1 ;  min 10 max 70 del 5
	local CIF_DIFFRACTOGRAM_BLOCK_ID = "some_characters";
	str
		scale 1e-4
	str
		scale 1e-4
	str
		scale 1e-4
yobs_eqn row_1_02.xy = 2 ;  min 10 max 70 del 5
	local CIF_DIFFRACTOGRAM_BLOCK_ID = "a_couple_of_ascii_things";
	str
		scale 2e-4
	str
		scale 1e-4
	str
		scale 2e-4
yobs_eqn row_1_03.xy = 3 ;  min 10 max 70 del 5
	local CIF_DIFFRACTOGRAM_BLOCK_ID = "another_string";
	str
		scale 3e-4
	str
		scale 1e-4
	str
		scale 3e-4

for xdds {
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.540596 lh 0.501844

	bkg 3 4 5

	for strs 1 to 1 {
		phase_name "Selenium"
		local CIF_PHASE_ID  1`
		local CIF_Z = 3;
		local CIF_SUM_FORMULA = "Se";
		local CID_CRYSTAL_SYSTEM = "hexagonal";
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second"
		local CIF_PHASE_ID  2`
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Pa";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		local CIF_PHASE_BLOCK_ID = "This_is_a_unique_string";
		phase_name "Tin"
		local CIF_PHASE_ID  3`
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Sn";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}


Out_pdCIF_multi(ciffile)

