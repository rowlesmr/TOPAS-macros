#include "../../pdcif2.inc"

macro ciffile { "single_many_2_2.cif" }
system_before_save_OUT { del ciffile }


Out_CIF2_initialise(ciffile)

CIF2_set_audit_dataset_id("60d9f912-aa2f-4967-9d32-c82d00e75cd1")

CIF2_set_scan_method("step")
CIF2_set_instr_id("Bragg_Instr")

yobs_eqn row_A = 1; min 10 max 70 del 5
	CIF2_set_cif_id(1)
	str
		scale 1e-4
	str
		scale 2e-4
	str
		scale 3e-4

yobs_eqn row_B = 2; min 10 max 70 del 5
	CIF2_set_cif_id(2)
	str
		scale 1e-4
	str
		scale 2e-4
	str
		scale 3e-4

for xdds {
	bkg 1 2 4
    Out_CIF2_wavelength_cuka1(ciffile, "radiation_src")

	for strs 1 to 1 {
		phase_name "Selenium"
		CIF2_set_formula_units_Z(3)
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second"
		CIF2_set_formula_units_Z(2)
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Tin"
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}

Out_pdCIF2(ciffile, "meas")

