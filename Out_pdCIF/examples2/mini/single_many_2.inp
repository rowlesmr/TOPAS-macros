#include "../cif.inc"

macro ciffile { "single_many_2.cif" }
system_before_save_OUT { del ciffile }

prm CIF_SCAN_METHOD = "step";

yobs_eqn row_A = 1; min 10 max 70 del 5
	local CIF_ID  1`
	str
		scale 1e-4
	str
		scale 2e-4
	str
		scale 3e-4

yobs_eqn row_B = 2; min 10 max 70 del 5
	local CIF_ID  2`
	str
		scale 1e-4
	str
		scale 2e-4
	str
		scale 3e-4

for xdds {
	bkg 1 2 4
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.54 lh 0.501844

	for strs 1 to 1 {
		phase_name "Selenium"
		local CIF_PHASE_ID  1`
		local CIF_Z = 3;
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second"
		local CIF_PHASE_ID  2`
		local CIF_Z = 2;
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Tin"
		local CIF_PHASE_ID  3`
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}

Out_pdCIF(ciffile, "meas")

