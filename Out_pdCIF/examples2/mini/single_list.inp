#include "../../pdcif2.inc"

macro ciffile { "single_list_2.cif" }
system_before_save_OUT { del ciffile }

num_runs 3
#list File_Name Temperature Date_Time {
row_A.xy	111   { "2022-01-11T14:32:57+0800" }
row_B.xy	222   { "2022-01-11T14:59:22+0800" }
row_C.xy	333   { "2022-01-11T15:31:52+0800" }
}

Out_CIF2_initialise(ciffile)

CIF2_set_audit_dataset_id("f31920c3-5019-4539-b7ce-080daf1aab5e")

CIF2_set_scan_method("cont")
CIF2_set_instr_id("Pangaku")
CIF2_set_temperature(Temperature(Run_Number))
CIF2_set_datetime_initialised(Date_Time(Run_Number))
CIF2_set_diffrn_id(String(Temperature(Run_Number)K))

yobs_eqn File_Name(Run_Number) = Run_Number; min 10 max 70 del 5
	bkg 3 4 5
    Out_CIF2_wavelength_cuka1(ciffile, "radiation_src")

	str
		phase_name "Selenium"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
		CIF2_set_crystal_system("hexagonal")
		scale 1e-4
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Second"
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Pa")
		CIF2_set_crystal_system("tetragonal")
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.

Out_pdCIF2(ciffile)

