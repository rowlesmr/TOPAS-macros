#include "../cif.inc"

macro ciffile { "single_list.cif" }
system_before_save_OUT { del ciffile }

num_runs 3
#list File_Name Temperature Date_Time {
row_A.xy	111   { "2022-01-11T14:32:57+0800" }
row_B.xy	222   { "2022-01-11T14:59:22+0800" }
row_C.xy	333   { "2022-01-11T15:31:52+0800" }
}

prm CIF_SCAN_METHOD = "cont";
prm CIF_DATETIME = Date_Time(Run_Number);
prm CIF_TEMP = Temperature(Run_Number);

yobs_eqn File_Name(Run_Number) = 1 Run_Number; min 10 max 70 del 5
	bkg 3 4 5
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.540596 lh 0.501844

	str
		phase_name "Selenium"
		local CIF_PHASE_ID  1`
		local CIF_Z = 3;
		local CIF_SUM_FORMULA = "Se";
		local CID_CRYSTAL_SYSTEM = "hexagonal";
		scale 1e-4
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Second"
		local CIF_PHASE_ID  2`
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Pa";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.

Out_pdCIF(ciffile)

