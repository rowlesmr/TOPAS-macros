#include "../../pdcif2.inc"

macro ciffile { "multi_many_2.cif" }
system_before_save_OUT { del ciffile }
Out_CIF2_initialise(ciffile)

CIF2_set_audit_dataset_id("3dc94574-b563-48cb-a5da-9fa455a3f7a7")

CIF2_set_scan_method("cont")
CIF2_set_instr_id("notlab")

' This is the first group
yobs_eqn row_1_01.xy = 1 ; min 10 max 70 del 5
	str
		scale 1e-4
	str
		scale 1e-4
	str
		scale 1e-4
yobs_eqn row_1_02.xy = 2 ; min 10 max 70 del 5
	str
		scale 2e-4
	str
		scale 1e-4
	str
		scale 2e-4
yobs_eqn row_1_03.xy = 3 ; min 10 max 70 del 5
	str
		scale 3e-4
	str
		scale 1e-4
	str
		scale 3e-4

'this is the second group
yobs_eqn row_2_01.xy = 4 ; min 10 max 70 del 5
	str
		scale 1e-4
	str
		scale 1e-4
	str
		scale 1e-4
yobs_eqn row_2_02.xy = 5 ; min 10 max 70 del 5
	str
		scale 2e-4
	str
		scale 1e-4
	str
		scale 2e-4
yobs_eqn row_2_03.xy = 6 ; min 10 max 70 del 5
	str
		scale 3e-4
	str
		scale 1e-4
	str
		scale 3e-4

'this is the third group
yobs_eqn row_3_01.xy = 7 ; min 10 max 70 del 5
	str
		scale 1e-4
	str
		scale 1e-4
	str
		scale 1e-4
yobs_eqn row_3_02.xy = 8 ; min 10 max 70 del 5
	str
		scale 2e-4
	str
		scale 1e-4
	str
		scale 2e-4
yobs_eqn row_3_03.xy = 9 ; min 10 max 70 del 5
	str
		scale 3e-4
	str
		scale 1e-4
	str
		scale 3e-4



for xdds 1 to 3 {
    Out_CIF2_wavelength_cuka1(ciffile, "radiationid")

	bkg 3 4 5

	CIF2_set_datetime_initialised("2022-01-11T14:32:57+0200")
	CIF2_set_cif_id(1)

	for strs 1 to 1 {
		phase_name "First"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
		CIF2_set_crystal_system("hexagonal")
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second"
		CIF2_set_sum_formula("Pa")
		CIF2_set_crystal_system("tetragonal")
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Third"
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Sn")
		CIF2_set_crystal_system("tetragonal")
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}


for xdds 4 to 6 {
   Out_CIF2_wavelength_cuka1(ciffile, "radiationid")

	bkg 3 4 5

	CIF2_set_datetime_initialised("2022-01-11T15:32:57+0200")
	CIF2_set_cif_id(2)

	for strs 1 to 1 {
		phase_name "First"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
		CIF2_set_crystal_system("hexagonal")
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second"
		CIF2_set_sum_formula("Pa")
		CIF2_set_crystal_system("tetragonal")
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Third"
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Sn")
		CIF2_set_crystal_system("tetragonal")
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}


for xdds 7 to 9 {
   Out_CIF2_wavelength_cuka1(ciffile, "radiationid")

	bkg 3 4 5

	CIF2_set_datetime_initialised("2022-01-11T15:32:57+0200")
	CIF2_set_cif_id(3)

	for strs 1 to 1 {
		phase_name "First"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
		CIF2_set_crystal_system("hexagonal")
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second"
		CIF2_set_sum_formula("Pa")
		CIF2_set_crystal_system("tetragonal")
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Third"
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Sn")
		CIF2_set_crystal_system("tetragonal")
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}


Out_pdCIF2_multi(ciffile, "proc", =Get(bkg);, 1, 3)
Out_pdCIF2_multi(ciffile, "proc", =Get(bkg);, 4, 6)
Out_pdCIF2_multi(ciffile, "proc", =Get(bkg);, 7, 9)

