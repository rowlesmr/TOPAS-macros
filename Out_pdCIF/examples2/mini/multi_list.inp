#include "../cif.inc"

macro ciffile { "multi_list.cif" }
system_before_save_OUT { del ciffile }

num_runs 3
#list File_Name_1 File_Name_2 File_Name_3 Temperature Date_Time Third_str_id{
row_1_01.xy	row_1_02.xy	row_1_03.xy	111   { "2022-01-11T14:32:57+1100" } { "This_is_a_unique_string" }
row_2_01.xy	row_2_02.xy	row_2_03.xy	222   { "2022-01-11T14:59:22+1100" } { "Here_are_some_unique_chars" }
row_3_01.xy	row_3_02.xy	row_3_03.xy	333   { "2022-01-11T15:31:52+1100" } { "This_is_just_a_string" }
}

prm CIF_SCAN_METHOD = "cont";
prm CIF_DATETIME = Date_Time(Run_Number);
prm CIF_TEMP = Temperature(Run_Number);

yobs_eqn File_Name_1(Run_Number) = 1 Run_Number; min 10 max 70 del 5
	str
		scale 1e-4
	str
		scale 1e-4
	str
		scale 1e-4
yobs_eqn File_Name_2(Run_Number) = 2 Run_Number; min 10 max 70 del 5
	str
		scale 2e-4
	str
		scale 1e-4
	str
		scale 2e-4
yobs_eqn File_Name_3(Run_Number) = 3 Run_Number; min 10 max 70 del 5
	str
		scale 3e-4
	str
		scale 1e-4
	str
		scale 3e-4

for xdds {
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.540596 lh 0.501844

	bkg 3 4 5

	for strs 1 to 1 {
		phase_name "First"
		local CIF_PHASE_ID  1`
		local CIF_Z = 3;
		local CIF_SUM_FORMULA = "Se";
		local CID_CRYSTAL_SYSTEM = "hexagonal";
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second"
		local CIF_PHASE_ID  2`
		local CIF_SUM_FORMULA = "Pa";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Third"
		local CIF_PHASE_ID  3`
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Sn";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}

Out_pdCIF_multi(ciffile)

