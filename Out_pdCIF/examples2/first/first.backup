#include "../../pdcif2.inc"

macro ciffile { "first_2.cif" }

/*
Input file and data used with permission from
http://community.dur.ac.uk/john.evans/topas_workshop/tutorial_multitopas.htm

Some slight modification done.
*/

'--------------------------------------------------------------
'Fitting Si + Al2O3 temperature standard
'Data collected with hot air blower so T(actual) < T(set) at high T
'File set up so that either topas v6 #list command or topas <v6 + command file can be used
'--------------------------------------------------------------
r_wp  14.7165479 r_exp  9.59752704 r_p  11.08605 r_wp_dash  26.1630795 r_p_dash  25.8227324 r_exp_dash  17.062484 weighted_Durbin_Watson  1.52575035 gof  1.53336873

iters 100000
chi2_convergence_criteria 0.001
do_errors

Backup_INP
out_file = Concat(String(INP_File), ".INP");
num_runs 8
#list File_Name Temperature {
xye_files\576460-mac-001_reb_0003.xye	310.49
xye_files\576464-mac-001_reb_0003.xye	383.07
xye_files\576468-mac-001_reb_0003.xye	457.98
xye_files\576472-mac-001_reb_0003.xye	534.38
xye_files\576476-mac-001_reb_0003.xye	611.44
xye_files\576480-mac-001_reb_0003.xye	754.81
xye_files\576484-mac-001_reb_0003.xye	935.48
xye_files\576488-mac-001_reb_0003.xye	1092.2
}

prm !te =Temperature(Run_Number);:935.48
CIF2_set_temperature(te)
CIF2_set_cif_id(Run_Number)
CIF2_set_scan_method("fixed")
CIF2_set_diffractometer_name("synchrotron somewhere")


macro filename { File_Name(Run_Number) }

#if Run_Number == 0;
system_before_save_OUT { del ciffile }
#endif

xdd filename
	start_X 5
	finish_X 65
	x_calculation_step = Yobs_dx_at(Xo);
	'lambda derived on peak shape derived on 574646-mac-001_offline.xye on 21/4/2017.xye by John 2016
	'Si zero was -1.69258/1000 degrees
	lam ymin_on_ymax 0.00001 la 1.0 lo   0.8257653_8.44468382e-008 lh 0.1
	LP_Factor( 90) 'change the LP correction  or lh value if required
   prm zero  0.412608069`_0.0407543281 th2_offset = (zero/1000);:  0.000412608069`_4.07543281e-05
	bkg @  35.6410484`_0.0653530916 -16.754996`_0.113002359 -1.47808275`_0.104674333  4.40222919`_0.103058743 -6.27562656`_0.103362698  10.6957232`_0.102950998 -7.71006618`_0.0987096064  0.756075393`_0.0968654125  4.93688219`_0.0941480845 -4.99115745`_0.0946559661  4.10910401`_0.091600484 -2.03254427`_0.0910743631 -0.594307515`_0.0895415769  3.9070021`_0.0898334171 -3.19621753`_0.0863635632  2.39954981`_0.0861903635 -1.45345209`_0.0784683692  0.775798707`_0.0762337687


    str
		phase_name "Al2O3"
		CIF2_set_formula_units_Z(6)
        CIF2_set_sum_formula("Al2 O3")
		Phase_Density_g_on_cm3( 3.92694303`_2.23027648e-05)
		'Sample size/strain include these lines for your sample
  		LVol_FWHM_CS_G_L(1, 349.099422`_32.2327363, 0.89, 486.712631`_45.2061415, csgc, 9999.86651`_94573.7364_LIMIT_MIN_0.3 , cslc, 547.666617`_28.2574222)
  		e0_from_Strain( 5.73622864e-05`_5.28019582e-06, sgc, 0.0170162027`_0.00218294322, slc, 0.0147411386`_0.00184627908)
		scale  scal_1  6.09191117e-05`_2.632e-07
		MVW( 611.768, 258.691`_0.001, 72.016`_0.130)
		Trigonal(lpa_1  4.782155`_0.000011, lpc_1  13.061809`_0.000045)
        CIF2_set_space_group_id("r_-3_c:H")
		space_group "r_-3_c:H"
		site Al1    x 0     y 0 z 0.148 occ Al+3 1 beq bval_1  0.69783`_0.01642
		site O1     x 0.306 y 0 z 0.25  occ O-2  1 beq bval_1  0.69783`_0.01642

	str
		phase_name "Si"
		CIF2_set_formula_units_Z(8)
		Phase_Density_g_on_cm3( 2.31209781`_9.70638908e-06)
		scale  scal_2  0.000103329648`_4.991e-07
		MVW( 224.684, 161.367`_0.001, 27.984`_0.130)
		Cubic(lpa_2  5.444255`_0.000008)
        CIF2_set_space_group_id("Fd-3mS")
		space_group "Fd-3mS"
		site Si1    x 0 y 0 z 0 occ Si 1 beq bval_2  1.44223`_0.01917

for strs {
		'peak shape derived on 574646-mac-001_offline.xye on 21/4/2017
		'This is a fixed instrumental profile
		'Just use size/strain on your sample
		TCHZ_Peak_Type(!pku,-0.00072_0.00002,!pkv, -0.00008_0.00001,!pkw, -0.00080_0.00002,!pkz, 0.00087_0.00002,!pky, 0.01490_0.00011,!pkx, 0.00175_0.00002)
		Simple_Axial_Model(!axial, 2.12938_0.00228)
}


Out_pdCIF2(ciffile, "proc")


