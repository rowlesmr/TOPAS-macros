macro file { "degussa.raw" }
macro seqno { Range_Number(Run_Number) }
prm !te = Temperature(Run_Number); :  373
macro outFileName { "output.txt" }






do_errors

CIF2_set_scan_method("cont")
CIF2_set_temperature(te)
CIF2_set_datetime_initialised(Date_Time(Run_Number))
CIF2_set_instr_id("main_lab")


Sequential_Refinement(20, seqno)


#define OUTPUT
#define CIF_OUTPUT

#ifdef OUTPUT
#if Run_Number == 0;
system_before_save_OUT { del outFileName }
system_before_save_OUT { del ciffile }
#endif
#endif

macro Output {
	 #if Run_Number == 0;
	 Out_Header(outFileName)
	 	O_H(temp)
	 	O_H(spec_disp)
	 	O_H(abs)
	 	O_H(csL)
	 	O_H(csG)
	 	O_H(strL)
	 	O_H(strG)
	 	O_H(Ti_beq)
	 	O_H(O_beq)
	 	O_H(a_del)
	 	O_H(c_del)
	 	O_H_cellprms
	 	O_H(Lvol)
	 	O_H(e0)
	 	O_H(density)
	 	O_H(LAC)
	 	O_H(scale)
	 	O_H(wtpct)
	 	O_H(RBragg)
	 	O_H(Rwp)
	 	O_H(Rexp)
	 	O_H(gof)
	 #endif

	for strs {
		Out_Results(outFileName) {
			O_R(te)
			O_R(sd)
			O_R(abs)
			O_R(csL)
			O_R(csG)
			O_R(strL)
			O_R(strG)
			O_R(Ti_beq)
			O_R(O_beq)
			O_R(a_del)
			O_R(c_del)
			O_R_cellprms(1)
			O_R(LVol_v(csG, csL))
			O_R(e0_v(strG, strL))
			O_R(Phase_Density_Eqn_g_on_cm3)
			O_R(Phase_LAC_Eqn_1_on_cm)
			O_R(Get(scale))
			O_R(Get(weight_percent))
			O_R(Get(r_bragg))
			O_R(Get(r_wp))
			O_R(Get(r_exp))
			O_R(Get(gof))
		}
	}
}



