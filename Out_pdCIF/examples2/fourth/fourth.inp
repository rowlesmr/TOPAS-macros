macro bghump(scaleStart, scaleStart_v, scaleMiddle, scaleMiddle_v, scaleEnd, scaleEnd_v)
{
   #m_argu scaleStart 	'scale of the bg hump at a point
   #m_argu scaleMiddle 	'scale of the bg hump at a point
   #m_argu scaleEnd 	 	'scale of the bg hump at a point
	If_Prm_Eqn_Rpt(scaleStart   , scaleStart_v, min 0.00001)
	If_Prm_Eqn_Rpt(scaleMiddle  , scaleMiddle_v, min 0.00001)
	If_Prm_Eqn_Rpt(scaleEnd 	 , scaleEnd_v, min 0.00001)

	'The bg at ~#15"
	BG_fit_PV_Peaks(19.4511883, 0.953922896, 11.7702918, = 821.888197 * CeV(scaleStart, scaleStart_v);)
	BG_fit_PV_Peaks(28.6437455, 0.178627756, 6.67854597, = 142.817267	* CeV(scaleStart, scaleStart_v);)
	BG_fit_PV_Peaks(43.9274194, 0.0625, 14.2135293, = 322.697876	* CeV(scaleStart, scaleStart_v);)

	'The bg at ~#110"
	BG_fit_PV_Peaks(19.2375845, 0.909057763, 12.8785928, = 849.331884 * CeV(scaleMiddle, scaleMiddle_v);)
	BG_fit_PV_Peaks(43.8474193, 0, 10.2011014, = 138.509377 * CeV(scaleMiddle, scaleMiddle_v);)

	'The bg at ~#166"
	BG_fit_PV_Peaks(19.4122357, 1, 11.7093252, = 712.823219 * CeV(scaleEnd, scaleEnd_v);)
	BG_fit_PV_Peaks(45.26, 0, 7.80276304, = 102.233436 * CeV(scaleEnd, scaleEnd_v);)
}

macro BG_fit_PV_Peaks(posn_cv, lor_cv, fwhm_cv, int_cv)
{
	xo_Is
		xo posn_cv
		peak_type pv
			pv_lor lor_cv
			pv_fwhm fwhm_cv
		I int_cv
}

macro sodalite(nax, na_occ, OW_occ) {
	space_group P-43n
    CIF2_set_space_group_id("P-43n")
	site Na 	num_posns  8	x =nax; 		y =nax;		z =nax;		occ Na+1 =na_occ;	beq  3.9
	site Al 	num_posns  6	x =1/4;		y =0; 		z =1/2;		occ Al+3  1			beq  1.39
	site Si 	num_posns  6	x =1/4;		y =1/2;		z =0;			occ Si+4  1			beq  1.36
	site O 	num_posns  24	x  0.1397 	y  0.1506 	z  0.4399 	occ O-2   1			beq  1.93
	site OW 	num_posns  24	x  0.0704 	y  0.1178 	z  -0.0526 	occ O-2 =OW_occ; 	beq  7.37
}

macro analcime(na_occ, al_occ, si_occ, o_occ, ow_occ) {
	space_group "Ia-3d"
    CIF2_set_space_group_id("Ia-3d")
	site Na  num_posns  24  x 0.125         y 0             z 0.25          occ Na+1 =2/3 na_occ;     		beq 3.75
	site Al  num_posns  48  x 0.66249       y 0.58751       z 0.125         occ Al+3 =1/3 al_occ;     		beq 0.95
	site Si  num_posns  48  x 0.66249       y 0.58751       z 0.125         occ Si+4 =2/3 si_occ;     		beq 0.95
	site O   num_posns  96  x 0.10485       y 0.13418       z 0.71936       occ O-2  =1 o_occ;          	beq 2.44
	site OW  num_posns  16  x 0.125         y 0.125         z 0.125         occ O-2  = ow_occ;	beq 5.92
}

macro analcime(num) {
	analcime(na_occ_anal_##num, al_occ_anal_##num, si_occ_anal_##num, o_occ_anal_##num, OW_occ_anal_##num)
}



