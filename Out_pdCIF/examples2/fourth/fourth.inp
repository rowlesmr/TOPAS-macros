	'this belongs to the sodalites
	prm NaOH_occ_20  0.688829625` min 0 max 1'how much NaOH is in the str?
	prm H2O_occ_20  0` min 0 max 1 'how much water is in the cage?

   str

		local !nax 0.1755 min 0 max 1	'Na position
		'Na occupancy -> 3/4 occ = Na6, 1/4 occ = Na2 for the NaOH in the cage
		' This prm should vary between 0.75 and 1
		local !na_occ =(3/4) + ((1/4) * NaOH_occ_20);:0.922207406`

		'OW occ
		'depends on both Na and H2O occ
		'max value is 1/6 = 4 O atoms -> (OH)2.2H2O
		local !OW_occ = ((1/12) * NaOH_occ_20) + ((1/12) * H2O_occ_20);:0.0574024687`

