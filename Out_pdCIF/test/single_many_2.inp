#include "../pdcif2.inc"
Out_CIF2_magic_number(ciffile)
CIF2_set_audit_dataset_id("bfa00366-aa4b-430a-bebe-936e96c35b48")

macro ciffile { "single_many_2.cif" }
system_before_save_OUT { del ciffile }

prm CIF_SCAN_METHOD = "step";

yobs_eqn row_A = 1; min 10 max 70 del 5
	CIF2_set_cif_id(1)
    CIF2_set_diffractogram_id("AA")
	str
		scale 1e-4
	str
		scale 2e-4
	str
		scale 3e-4

yobs_eqn row_B = 2; min 10 max 70 del 5
	CIF2_set_cif_id(2)
    CIF2_set_diffractogram_id("BB")
	str
		scale 3e-4
	str
		scale 2e-4
	str
		scale 1e-4

for xdds {
    CIF2_set_instr_id("main_lab")
	CIF2_set_scan_method("cont")

    bkg 0 1 2

    Out_CIF2_wavelength_cuka5(ciffile, "copper_lab", 40, 40)

	for strs 1 to 1 {
		phase_name "Selenium"
		CIF2_set_formula_units_Z(3)
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second"
		CIF2_set_formula_units_Z(2)
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Tin"
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}

Out_pdCIF2(ciffile, "meas")

