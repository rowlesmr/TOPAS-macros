#include "../pdcif2.inc"
Out_CIF2_magic_number(ciffile)
CIF2_set_audit_dataset_id("9279adb3-34b3-44d9-8fd1-80348e89241a")

macro ciffile { "single_many_1.cif" }
system_before_save_OUT { del ciffile }

yobs_eqn row_A = 1; min 10 max 70 del 5
    CIF2_set_cif_id(1)
    CIF2_set_instr_id("main_lab")
    CIF2_set_diffractogram_id("A")
	CIF2_set_scan_method("step")

    bkg 0 1 2

    Out_CIF2_wavelength_cuka5(ciffile, "copper_lab", 40, 40)


	str
		phase_name "Selenium"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
        CIF2_set_crystal_system("hexagonal")
		scale 1e-4
		Hexagonal(3.992, 3.119)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Tin"
		CIF2_set_phase_id("This_is_a_unique_string")
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Sn")
        CIF2_set_crystal_system("tetragonal")
		scale 1e-4
		Tetragonal(3.448, 3.251)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1

	Out_pdCIF2_per_xdd(ciffile, "meas")

yobs_eqn row_B = 2; min 10 max 70 del 5
    CIF2_set_cif_id(2)
    CIF2_set_instr_id("alternate_lab")
    CIF2_set_diffractogram_id("B")
	CIF2_set_scan_method("cont")

    bkg 0 1 2

    Out_CIF2_wavelength_cuk1sharp(ciffile, "copper_sharp", 40, 40)

	str
		phase_name "Selenium"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
        CIF2_set_crystal_system("hexagonal")
		scale 1e-4
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Second"
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Pa")
        CIF2_set_crystal_system("tetragonal")
		scale 1e-4
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.

	str
		phase_name "Tin"
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Sn")
        CIF2_set_crystal_system("tetragonal")
		scale 1e-4
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1

	Out_pdCIF2_per_xdd(ciffile, "proc",)

