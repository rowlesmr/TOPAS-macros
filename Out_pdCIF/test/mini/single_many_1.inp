#include "../cif.inc"

macro ciffile { "single_many_1.cif" }
system_before_save_OUT { del ciffile }

yobs_eqn row_A = 1; min 10 max 70 del 5
	bkg 0 1 2
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.54 lh 0.501844

	local CIF_ID  1`
	local CIF_SCAN_METHOD = "step";

	str
		phase_name "Selenium"
		local CIF_PHASE_ID  1`
		local CIF_Z = 3;
		local CIF_SUM_FORMULA = "Se";
		local CID_CRYSTAL_SYSTEM = "hexagonal";
		scale 1e-4
		Hexagonal(3.992, 3.119)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Tin"
		local CIF_PHASE_ID  2`
		local CIF_PHASE_BLOCK_ID = "This_is_a_unique_string";
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Sn";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		scale 1e-4
		Tetragonal(3.448, 3.251)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1

	Out_pdCIF_per_xdd(ciffile, "meas")

yobs_eqn row_B = 2; min 10 max 70 del 5
	bkg 1 2 4
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.54 lh 0.501844

	local CIF_ID  2`
	local CIF_SCAN_METHOD = "cont";

	str
		phase_name "Selenium"
		local CIF_PHASE_ID  1`
		local CIF_Z = 3;
		local CIF_SUM_FORMULA = "Se";
		local CID_CRYSTAL_SYSTEM = "hexagonal";
		scale 1e-4
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Second"
		local CIF_PHASE_ID  2`
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Pa";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.

	str
		phase_name "Tin"
		local CIF_PHASE_ID  3`
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Sn";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		scale 1e-4
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1

	Out_pdCIF_per_xdd(ciffile, "proc",)

