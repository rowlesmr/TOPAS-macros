macro file { "degussa.raw" }
macro seqno { Range_Number(Run_Number) }

macro ciffile { "second.cif" }

do_errors

prm CIF_SCAN_METHOD = "cont";
prm CIF_TEMPERATURE  =Temperature(Run_Number); :  303`
prm CIF_DATETIME = Date_Time(Run_Number);
prm CIF_DIFFRACTOGRAM_ID = DiffractogramID(Run_Number); 'if this isn't here, there should be an auto-generated name
prm CIF_INSTR_ID = "INST";
prm CIF_DIFFRN_ID = DiffrnID(Run_Number);

Sequential_Refinement(20, seqno)

#define CIF_OUTPUT

#ifdef CIF_OUTPUT
#if Run_Number == 0;
system_before_save_OUT { del ciffile }
#endif
#endif

