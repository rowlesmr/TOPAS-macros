#include "../pdcif2.inc"
Out_CIF2_magic_number(ciffile)

CIF2_set_audit_dataset_id("29c5e709-094e-45f7-99b2-1eeed500725e")


macro ciffile { "single_list.cif" }
if Run_Number == 0 { system_before_save_OUT { del ciffile } }
out_file = Concat(String(INP_File), ".OUTPUT");


num_runs 3
#list File_Name Temperature Date_Time Diffrn_ID diffractogram_id {
row_A.xy	111   { "2022-01-11T14:32:57+0800" } "111K" "the_first"
row_B.xy	222   { "2022-01-11T14:59:22+0800" } "222K" "number_2"
row_C.xy	333   { "2022-01-11T15:31:52+0800" } "333K" "thirdly"
}

CIF2_set_scan_method("cont")
CIF2_set_datetime_initialised(Date_Time(Run_Number))
CIF2_set_temperature(Temperature(Run_Number))
CIF2_set_pressure(101.3)
CIF2_set_diffrn_id(Diffrn_ID(Run_Number))
CIF2_set_instr_id("insitu_lab")
CIF2_set_diffractogram_id(diffractogram_id(Run_Number))

yobs_eqn File_Name(Run_Number) = 1 Run_Number; min 10 max 70 del 5
	bkg 3 4 5

    CIF2_set_cif_id(10*(Run_Number+1)) 'CIF_ID can be auto-populated when using #list, so this isn't strictly necessary

    'this is the source of the wavelength; it's copied from the TOPAS presets
    Out_CIF2_wavelength_cuk1sharp(ciffile, "mono", 40, 45)

    'this is the normal BB specimen displacement, and cuases the corrected 2Th values to be written to file, too.
    pdCIF2_Bragg_Brentano_specimen_displacement((Run_Number+1)/20)

    'this just reports the numbers; it doesn't afffect the refinement in any manner
    Out_pdCIF2_simple_Bragg_Brentano_instr_premono_report_only(ciffile, 27.26, "Ge 111",
                                                                        275,
                                                                        0.25,
                                                                        4, 4,)
    LP_Factor(27.26)
    Radius(275)
    Divergence(0.25)
    Full_Axial_Model(12, 15, 12, 4, 4)


	str
		phase_name "Selenium"
		CIF2_set_formula_units_Z(3)
		CIF2_set_sum_formula("Se")
		CIF2_set_crystal_system("hexagonal")
        CIF2_set_space_group_id(Get(sp_grp_char))
        CIF2_set_model_id(Sel_mod_##Run_Number)
        CIF2_set_structure_id(Sel_str_##Run_Number)

        'this actually does PO corrections, and writes them to file. There also exist 2 & 3 direction versions, as well as SH.
        Out_pdCIF2_PO_March_Dollase(ciffile, !po1, =0.654+(Run_Number/10);, 1,2,-3)
		scale 1e-4
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1

	str
		phase_name "Second"
		CIF2_set_formula_units_Z(2)
		CIF2_set_sum_formula("Sn")
		CIF2_set_crystal_system("tetragonal")
        CIF2_set_space_group_id(Get(sp_grp_char))
		scale 1e-4
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.

Out_pdCIF2(ciffile)

