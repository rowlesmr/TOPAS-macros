#include "../pdcif2.inc"
Out_CIF2_magic_number(ciffile)

macro ciffile { "multi_many.cif" }
system_before_save_OUT { del ciffile }

prm CIF_SCAN_METHOD = "cont";

' This is the first group
yobs_eqn row_1_01.xy = 1 ; min 10 max 70 del 5
	str
		scale 1.1e-4
	str
		scale 1.1e-4
	str
		scale 1.1e-4
yobs_eqn row_1_02.xy = 2 ; min 10 max 70 del 5
	str
		scale 2.1e-4
	str
		scale 1.1e-4
	str
		scale 2.1e-4
yobs_eqn row_1_03.xy = 3 ; min 10 max 70 del 5
	str
		scale 3.1e-4
	str
		scale 1.1e-4
	str
		scale 3.1e-4

'this is the second group
yobs_eqn row_2_01.xy = 4 ; min 10 max 70 del 5
	str
		scale 1.2e-4
	str
		scale 1.2e-4
	str
		scale 1.2e-4
yobs_eqn row_2_02.xy = 5 ; min 10 max 70 del 5
	str
		scale 2.2e-4
	str
		scale 1.2e-4
	str
		scale 2.2e-4
yobs_eqn row_2_03.xy = 6 ; min 10 max 70 del 5
	str
		scale 3.2e-4
	str
		scale 1.2e-4
	str
		scale 3.2e-4

'this is the third group
yobs_eqn row_3_01.xy = 7 ; min 10 max 70 del 5
	str
		scale 1.3e-4
	str
		scale 1.3e-4
	str
		scale 1.3e-4
yobs_eqn row_3_02.xy = 8 ; min 10 max 70 del 5
	str
		scale 2.3e-4
	str
		scale 1.3e-4
	str
		scale 2.3e-4
yobs_eqn row_3_03.xy = 9 ; min 10 max 70 del 5
	str
		scale 3.3e-4
	str
		scale 1.3e-4
	str
		scale 3.3e-4



for xdds 1 to 3 {
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.540596 lh 0.501844

	bkg 3 4 5

	local CIF_DATETIME = "2022-01-11T14:32:57+0200";
	local CIF_ID  1`

	for strs 1 to 1 {
		phase_name "First1"
		local CIF_Z = 3;
		local CIF_SUM_FORMULA = "Se";
		local CID_CRYSTAL_SYSTEM = "hexagonal";
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second1"
		local CIF_SUM_FORMULA = "Pa";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Third1"
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Sn";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}


for xdds 4 to 6 {
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.540596 lh 0.501844

	bkg 3 4 5

	local CIF_DATETIME = "2022-01-11T15:32:57+0200";
	local CIF_ID  2`

	for strs 1 to 1 {
		phase_name "First2"
		local CIF_Z = 3;
		local CIF_SUM_FORMULA = "Se";
		local CID_CRYSTAL_SYSTEM = "hexagonal";
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second2"
		local CIF_SUM_FORMULA = "Pa";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Third2"
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Sn";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}


for xdds 7 to 9 {
   lam
		ymin_on_ymax 0.0001
		la 1 lo 1.540596 lh 0.501844

	bkg 3 4 5

	local CIF_DATETIME = "2022-01-11T16:32:57+0200";
	local CIF_ID  3`

	for strs 1 to 1 {
		phase_name "First3"
		local CIF_Z = 3;
		local CIF_SUM_FORMULA = "Se";
		local CID_CRYSTAL_SYSTEM = "hexagonal";
		Hexagonal(3.9, 3.1)
		space_group "R-3m"
		site Se1 num_posns  3	x 0 y 0 z 0 occ Se 1 beq 1
	}

	for strs 2 to 2 {
		phase_name "Second3"
		local CIF_SUM_FORMULA = "Pa";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.9, 3.2)
		space_group "I4/mmm"
		site Pa1 num_posns  2	x 0.0 y 0.0 z 0.0 occ Pa 1.0 beq 1.
	}

	for strs 3 to 3 {
		phase_name "Third3"
		local CIF_Z = 2;
		local CIF_SUM_FORMULA = "Sn";
		local CID_CRYSTAL_SYSTEM = "tetragonal";
		Tetragonal(3.4, 3.2)
		space_group "I4/mmm"
		site Sn1 num_posns  2 x 0 y 0 z 0 occ Sn 1 beq 1
	}
}


Out_pdCIF2_multi(ciffile, "proc", =Get(bkg);, 1, 3)
Out_pdCIF2_multi(ciffile, "proc", =Get(bkg);, 4, 6)
Out_pdCIF2_multi(ciffile, "proc", =Get(bkg);, 7, 9)

